fn graphics_settings(var kiln::Target& target, kiln::Options& options) -> void | kiln::configuration_error | rt::allocation_error {
	rt::string compiler = options.value("cxx", "cl");
	rt::string linker = options.value("linker", "link");
	cpp::Settings settings = cpp::settings();
	@settings.compiler(compiler);
	@settings.standard("c++latest");
	@target.compilers.add(cpp::compiler, settings);
	@target.linker(linker);
};

fn build(kiln::Options& options) -> void | kiln::configuration_error | rt::allocation_error {
	kiln::load("cpp", &cpp::load);
	kiln::load("rtsl", &rtsl::load);
	kiln::load("vcpkg", &vcpkg::load);
	var egl = vcpkg::package("egl-registry");
	@egl.option("headers", "EGL/egl.h");
	var volk = vcpkg::package("volk");
	@volk.option("headers", "volk.h");
	if (options.os() == "windows") {
		@volk.option("libraries", "volk.lib");
	}
	else {
		@volk.option("libraries", "libvolk.a");
	};
	if (options.os() == "macos") {
		var moltenvk = vcpkg::package("MoltenVK");
		@moltenvk.option("headers", "MoltenVK/mvk_vulkan.h");
		@moltenvk.option("runtime_files", "lib/libMoltenVK.dylib");
	};
	var allocator = vcpkg::package("vma");
	if (options.os() == "windows") {
		@allocator.option("headers", "vma/vk_mem_alloc.h");
		@allocator.option("includes", "include/vma");
	}
	else {
		@allocator.option("headers", "vk_mem_alloc.h");
	};
	kiln::add_subdirectory("RTSL", options);
	var api = kiln::add_target("rutile", kiln::TargetType::static_lib);
	graphics_settings(@api, options);
	@api.option("includes", "include;src");
	@api.option("public_includes", "include");
	rtsl::Program antialias = rtsl::program("rt-antialias-shaders");
	@antialias.sources.add("src/shaders/antialias.rtsl");
	@antialias.module("antialias");
	@antialias.symbol("rt_antialias_program");
	@api.depends_on(antialias);
	@api.sources.add("src/rutile.c");
	@api.sources.add("src/rt_ext_swapchain.c");
	@api.sources.add("src/rt_ext_glfw.c");
	@api.sources.add("src/rt_antialias.c");

	var vulkan = kiln::add_target("rt-vulkan", kiln::TargetType::shared_lib);
	graphics_settings(@vulkan, options);
	@vulkan.option("includes", "backends/rt-vulkan/src;backends/rt-vulkan/src/system;RTSL/include");
	@vulkan.package("SPIRV-Tools");
	@vulkan.package("volk");
	@vulkan.package("vma");
	if (options.os() == "macos") {
		@vulkan.package("MoltenVK");
		@vulkan.sources.add("backends/rt-vulkan/src/system/macos/loader.c");
		@vulkan.option("link_options", "-Wl,-rpath,@loader_path;-Wl,-rpath,@executable_path;-Wl,-framework,Metal;-Wl,-framework,QuartzCore;-Wl,-framework,Foundation");
	};
	@vulkan.option("defines", "VK_NO_PROTOTYPES;VMA_STATIC_VULKAN_FUNCTIONS=0;VMA_DYNAMIC_VULKAN_FUNCTIONS=1");
	if (options.profile() == "debug") {
		@vulkan.option("defines", "VK_NO_PROTOTYPES;VMA_STATIC_VULKAN_FUNCTIONS=0;VMA_DYNAMIC_VULKAN_FUNCTIONS=1;RTVK_ENABLE_VULKAN_VALIDATION");
	};
	@vulkan.depends_on("rtsl-runtime");
	@vulkan.sources.add("backends/rt-vulkan/src/context.c");
	@vulkan.sources.add("backends/rt-vulkan/src/core.c");
	@vulkan.sources.add("backends/rt-vulkan/src/error.c");
	@vulkan.sources.add("backends/rt-vulkan/src/glfw.c");
	@vulkan.sources.add("backends/rt-vulkan/src/resource/buffer.c");
	@vulkan.sources.add("backends/rt-vulkan/src/resource/command_buffer.c");
	@vulkan.sources.add("backends/rt-vulkan/src/resource/framebuffer.c");
	@vulkan.sources.add("backends/rt-vulkan/src/resource/program.c");
	@vulkan.sources.add("backends/rt-vulkan/src/resource/queue.c");
	@vulkan.sources.add("backends/rt-vulkan/src/resource/resource.c");
	@vulkan.sources.add("backends/rt-vulkan/src/resource/sampler.c");
	@vulkan.sources.add("backends/rt-vulkan/src/resource/swapchain.c");
	@vulkan.sources.add("backends/rt-vulkan/src/resource/swapchain_build.cpp");
	@vulkan.sources.add("backends/rt-vulkan/src/resource/texture.c");
	@vulkan.sources.add("backends/rt-vulkan/src/system/atomic.cpp");
	if (options.os() == "windows") {
		@vulkan.sources.add("backends/rt-vulkan/src/system/windows/sync.c");
	}
	else {
		@vulkan.sources.add("backends/rt-vulkan/src/system/posix/sync.c");
		if (options.os() == "linux") {
			@vulkan.option("link_options", "-ldl;-pthread");
		};
	};
	@vulkan.sources.add("backends/rt-vulkan/src/transpiler/transpiler.cpp");
	@vulkan.sources.add("backends/rt-vulkan/src/vma.cpp");

	var opengl = kiln::add_target("rt-opengl", kiln::TargetType::shared_lib);
	graphics_settings(@opengl, options);
	@opengl.option("includes", "backends/rt-opengl/src;RTSL/include");
	@opengl.package("SPIRV-Tools");
	if (options.os() == "windows") {
		@opengl.option("link_options", "opengl32.lib;gdi32.lib;user32.lib");
	};
	@opengl.depends_on("rtsl-runtime");
	@opengl.sources.add("backends/rt-opengl/src/context.c");
	@opengl.sources.add("backends/rt-opengl/src/core.c");
	@opengl.sources.add("backends/rt-opengl/src/error.c");
	@opengl.sources.add("backends/rt-opengl/src/execution/commands.cpp");
	@opengl.sources.add("backends/rt-opengl/src/execution/execution.cpp");
	@opengl.sources.add("backends/rt-opengl/src/glad/gl.c");
	@opengl.sources.add("backends/rt-opengl/src/glfw.c");
	@opengl.sources.add("backends/rt-opengl/src/resource/buffer.c");
	@opengl.sources.add("backends/rt-opengl/src/resource/command_buffer.cpp");
	@opengl.sources.add("backends/rt-opengl/src/resource/framebuffer.c");
	@opengl.sources.add("backends/rt-opengl/src/resource/program.c");
	@opengl.sources.add("backends/rt-opengl/src/resource/queue.c");
	@opengl.sources.add("backends/rt-opengl/src/resource/resource.c");
	@opengl.sources.add("backends/rt-opengl/src/resource/sampler.c");
	@opengl.sources.add("backends/rt-opengl/src/resource/swapchain.c");
	@opengl.sources.add("backends/rt-opengl/src/resource/texture.c");
	if (options.os() == "windows") {
		@opengl.sources.add("backends/rt-opengl/src/platform/wgl/context.c");
		@opengl.sources.add("backends/rt-opengl/src/system/windows/atomic.cpp");
		@opengl.sources.add("backends/rt-opengl/src/system/windows/sync.cpp");
	}
	else {
		@opengl.sources.add("backends/rt-opengl/src/platform/posix/proc.c");
		@opengl.sources.add("backends/rt-opengl/src/system/posix/atomic.cpp");
		@opengl.sources.add("backends/rt-opengl/src/system/posix/sync.cpp");
		if (options.os() == "macos") {
			@opengl.sources.add("backends/rt-opengl/src/platform/cgl/context.c");
			@opengl.option("link_options", "-pthread;-Wl,-framework,OpenGL");
		}
		else {
			@opengl.sources.add("backends/rt-opengl/src/platform/egl/context.c");
			@opengl.package("egl-registry");
			@opengl.option("link_options", "-ldl;-pthread");
		};
	};
	@opengl.sources.add("backends/rt-opengl/src/transpiler/transpiler.cpp");

	if (options.os() == "windows") {
		var software = kiln::add_target("rt-software", kiln::TargetType::shared_lib);
		graphics_settings(@software, options);
		@software.option("includes", "backends/rt-software/src;backends/rt-software/src/execution;backends/rt-software/src/interpreter;backends/rt-software/src/resource");
		@software.sources.add("backends/rt-software/src/context.c");
		@software.sources.add("backends/rt-software/src/core.c");
		@software.sources.add("backends/rt-software/src/error.c");
		@software.sources.add("backends/rt-software/src/execution/execution.c");
		@software.sources.add("backends/rt-software/src/interpreter/artifact.c");
		@software.sources.add("backends/rt-software/src/interpreter/execute.c");
		@software.sources.add("backends/rt-software/src/resource/buffer.c");
		@software.sources.add("backends/rt-software/src/resource/command_buffer.c");
		@software.sources.add("backends/rt-software/src/resource/framebuffer.c");
		@software.sources.add("backends/rt-software/src/resource/resource.c");
		@software.sources.add("backends/rt-software/src/resource/sampler.c");
		@software.sources.add("backends/rt-software/src/resource/queue.c");
		@software.sources.add("backends/rt-software/src/resource/program.c");
		@software.sources.add("backends/rt-software/src/resource/texture.c");
		@software.sources.add("backends/rt-software/src/presentation/windows/glfw.c");
		@software.sources.add("backends/rt-software/src/presentation/windows/swapchain.c");
	
		var d3d12 = kiln::add_target("rt-d3d12", kiln::TargetType::shared_lib);
		graphics_settings(@d3d12, options);
		@d3d12.option("includes", "backends/rt-d3d12/src;RTSL/include");
		@d3d12.option("libraries", "d3d12.lib;dxgi.lib;dxguid.lib;dxcompiler.lib");
		if (options.profile() == "debug") {
			@d3d12.option("defines", "RTD3D12_ENABLE_D3D12_VALIDATION");
		};
		@d3d12.depends_on("rtsl-runtime");
		@d3d12.sources.add("backends/rt-d3d12/src/context.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/core.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/error.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/glfw.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/init.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/resource/buffer.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/resource/command_buffer.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/resource/framebuffer.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/resource/program.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/resource/queue.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/resource/resource.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/resource/sampler.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/resource/swapchain.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/resource/texture.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/sync.cpp");
		@d3d12.sources.add("backends/rt-d3d12/src/transpiler/hlsl.cpp");
	};

	var logging = kiln::add_target("rt-logging-layer", kiln::TargetType::shared_lib);
	graphics_settings(@logging, options);
	@logging.option("includes", "include");
	@logging.option("defines", "RT_BUILD_DLL");
	@logging.sources.add("layers/rt-logging/src/entry.c");
	@logging.sources.add("layers/rt-logging/src/forward.c");
	@logging.sources.add("layers/rt-logging/src/logger.c");
	@logging.sources.add("layers/rt-logging/src/state.c");

	var validation = kiln::add_target("rt-validation-layer", kiln::TargetType::shared_lib);
	graphics_settings(@validation, options);
	@validation.option("includes", "include");
	@validation.option("defines", "RT_BUILD_DLL");
	@validation.sources.add("layers/rt-validation/src/buffer.c");
	@validation.sources.add("layers/rt-validation/src/command_buffer.c");
	@validation.sources.add("layers/rt-validation/src/core.c");
	@validation.sources.add("layers/rt-validation/src/entry.c");
	@validation.sources.add("layers/rt-validation/src/framebuffer.c");
	@validation.sources.add("layers/rt-validation/src/program.c");
	@validation.sources.add("layers/rt-validation/src/logger.c");
	@validation.sources.add("layers/rt-validation/src/queue.c");
	@validation.sources.add("layers/rt-validation/src/sampler.c");
	@validation.sources.add("layers/rt-validation/src/state.c");
	@validation.sources.add("layers/rt-validation/src/swapchain.c");
	@validation.sources.add("layers/rt-validation/src/texture.c");
};
